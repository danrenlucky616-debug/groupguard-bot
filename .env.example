# ============================================================
# GROUPGUARD - ENVIRONMENT TEMPLATE
# ============================================================

# Your main owner number.
# International format, without +, spaces or dashes.
OWNER_NUMBER=

# Render server port
PORT=10000

# Application environment
NODE_ENV=production

# Logging level
LOG_LEVEL=info

# Secret used to protect private API operations.
# Generate a strong random value for the real .env file.
API_SECRET=

# Bot name
BOT_NAME=groupguard-bot